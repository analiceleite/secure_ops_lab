{
  "name": "SecureOps - entrega local de relatórios v1 (candidato)",
  "nodes": [
    {
      "id": "schedule",
      "name": "Verificar outbox a cada 30s",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0],
      "parameters": {"rule": {"interval": [{"field": "seconds", "secondsInterval": 30}]}}
    },
    {
      "id": "claim",
      "name": "Reservar mensagem pendente",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [240, 0],
      "parameters": {"operation": "executeQuery", "query": "SELECT incident.claim_report_outbox(90) AS delivery", "options": {"queryBatching": "single"}}
    },
    {
      "id": "has-message",
      "name": "Há mensagem para enviar?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [480, 0],
      "parameters": {
        "conditions": {"options": {"caseSensitive": true, "typeValidation": "strict", "version": 2},
          "conditions": [{"id": "delivery", "leftValue": "={{ $json.delivery !== null }}", "rightValue": true, "operator": {"type": "boolean", "operation": "true", "singleValue": true}}], "combinator": "and"},
        "options": {}
      }
    },
    {
      "id": "send-mail",
      "name": "Enviar apenas ao Mailpit local",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [720, -120],
      "parameters": {
        "fromEmail": "secureops@lab.invalid",
        "toEmail": "operadora@lab.invalid",
        "subject": "={{ $json.delivery.subject }}",
        "emailFormat": "both",
        "text": "={{ $json.delivery.text }}",
        "html": "={{ $json.delivery.html }}",
        "options": {"appendAttribution": false}
      }
    },
    {
      "id": "mark-accepted",
      "name": "Registrar aceite SMTP",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [960, -120],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT incident.finish_report_delivery($1::bigint, 'accepted') AS result",
        "options": {"queryBatching": "single", "queryReplacement": "={{ [$('Reservar mensagem pendente').item.json.delivery.outbox_id] }}"}
      }
    }
  ],
  "connections": {
    "Verificar outbox a cada 30s": {"main": [[{"node": "Reservar mensagem pendente", "type": "main", "index": 0}]]},
    "Reservar mensagem pendente": {"main": [[{"node": "Há mensagem para enviar?", "type": "main", "index": 0}]]},
    "Há mensagem para enviar?": {"main": [[{"node": "Enviar apenas ao Mailpit local", "type": "main", "index": 0}], []]},
    "Enviar apenas ao Mailpit local": {"main": [[{"node": "Registrar aceite SMTP", "type": "main", "index": 0}]]}
  },
  "active": false,
  "settings": {"executionOrder": "v1", "saveDataErrorExecution": "none", "saveDataSuccessExecution": "none", "saveManualExecutions": false},
  "versionId": "92426ef4-3071-47ea-bd7c-7c8db648afd8",
  "meta": {"templateCredsSetupCompleted": false},
  "tags": []
}
